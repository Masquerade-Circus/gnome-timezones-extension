<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.timezones" path="/org/gnome/shell/extensions/timezone/">
    <key name="timezones" type="as">
      <default>[]</default>
    </key>
    <key name="config" type="a{sb}">
      <default>{}</default>
    </key>
    <key name="labels" type="a{ss}">
