{
  "name": "gnome-timezones-extension",
  "version": "0.0.0",
  "description": "Show multiple clock timezones in the panel",
  "main": "extension.js",
  "repository": "git@github.com:Masquerade-Circus/gnome-timezones-extension.git",
  "license": "Apache-2.0",
  "author": "Masquerade <christian@masquerade-circus.net>",
  "private": false,
  "type": "module",
  "keywords": [
    "gnome",
    "gnome-shell",
    "extension",
    "clock",
    "timezones",
    "multiple"
  ],
  "scripts": {
    "watch-log": "journalctl -f -o cat /usr/bin/gnome-shell",
    "enable": "gnome-extensions enable timezones@masquerade-circus.net",
    "disable": "gnome-extensions disable timezones@masquerade-circus.net",
    "compile": "glib-compile-schemas schemas/",
    "zip": "gnome-extensions pack --force --extra-source=lib --schema=schemas/org.gnome.shell.extensions.timezones.gschema.xml .",
    "build": "yarn compile && yarn zip",
    "install-zip": "gnome-extensions install --force timezones@masquerade-circus.net.shell-extension.zip"
  },
  "dependencies": {},
  "devDependencies": {
    "babel-eslint": "^10.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^7.32.0",
    "eslint-plugin-gjs": "bartlibert/eslint-plugin-gjs",
    "eslint-plugin-sonarjs": "^0.10.0"
  }
}
